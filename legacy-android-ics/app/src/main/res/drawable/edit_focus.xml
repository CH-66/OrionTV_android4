<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#23282D" />
            <stroke android:width="2dp" android:color="@color/orion_focus" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#23282D" />
            <stroke android:width="1dp" android:color="#394047" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
