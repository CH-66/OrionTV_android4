<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#183223" />
            <stroke android:width="2dp" android:color="@color/orion_focus" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#183223" />
            <stroke android:width="2dp" android:color="@color/orion_focus" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#183223" />
            <stroke android:width="2dp" android:color="@color/orion_focus" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#21482F" />
            <stroke android:width="1dp" android:color="@color/orion_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141B17" />
            <stroke android:width="1dp" android:color="#25332B" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
